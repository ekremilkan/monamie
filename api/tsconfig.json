{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false
  },
  "include": [
    "src", // Projemize 'src' klasörünü dahil et
    "prisma/seed.ts" // Ve projemize 'prisma/seed.ts' dosyasını da AÇIKÇA dahil et
  ],
  "exclude": [
    "node_modules" // Sadece 'node_modules' klasörünü hariç tut
  ]
}
